# ============================================================
# SilverShield Home 感知模块 - .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- 本地 Agent 状态（项目记忆 / 工作笔记，禁止入库）---
.workbuddy/
.claude/


# --- 密钥 / 本地配置（含真实凭证与设备序列号，禁止入库）---
.env
.env.local
prototypes/
config/devices.yaml

# --- 模型权重 / 证据数据（体积大，不入库）---
# YOLO 权重（含根目录误落下的 yolo11n.pt）；权重应放 ~/.cache 或 data/models/ 并下载，不入库
*.pt
*.onnx
*.engine
data/models/

# --- 评估产出物（可由 `python -m home_perception.memory.evaluation` 再生成，含时间戳，不入库）---
artifacts/
# Memory 运行时快照（data/memory/snapshot.json，运行期产物，可再生成，不入库）
data/memory/

# --- 设计思路草稿（团队研究稿，非模块交付；终稿已沉淀到 docs/）---
.doc/
# 设计评审草稿（.DESIGN-*.md，review 中间稿，非交付物）
docs/.DESIGN-*.md
data/evidence/**
data/cache/**
*.mp4
*.mpg
*.avi
*.jpg
!data/evidence/.gitkeep

# 注意：data/demo/ 入库（验证报告 + 区域审计，文本/JSON，体积小，长期资产）

# --- 编辑器 / 系统 ---
.idea/
.vscode/
.DS_Store
# Windows 保留设备名副产品（重定向意外产生的"幽灵文件"，无法 del，强制忽略）
nul

# --- 测试 / 覆盖率缓存 ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- 基准 / 运行产物（benchmark JSON、临时输出，不入库）---
out/
var/

# --- 合成场景产物（scenarios/audio 声明式生成，可由脚本再生成，不入库）---
generated/

# --- Soak Test 报告（长时间运行产物，体积大，不入库）---
reports/
# 例外：docs/reports/ 是固化的验证报告（文本资产，入库）
!docs/reports/
evidence_explorer.html

# 黄金案例集（Golden Scenario Set）资产：AI/真实视频 + 合成音频 + 生产脚本
# 大体积生产素材不入库（视频已由 *.mp4 全局忽略；整体忽略以覆盖 wav/yaml/png/脚本）
data/golden/

# --- 本地 Agent 状态 / 工具链 ---
.arts/

# --- 开发环境管理 ---
.mise.toml

# --- 数据集 / 测试产物（大文件，不入库） ---
dataset/
test_screenshots/
test_output.txt
debug_*.py
verify_*.py
_verify_fold.py

# --- CodeGraph 索引 ---
.codegraph/
