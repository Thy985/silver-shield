# ============================================================
# 本地环境变量模板（复制为 .env 后填写，.env 已被 gitignore）
# 切勿把真实值提交到仓库
# ============================================================

# --- 萤石开放平台凭证 (https://open.ys7.com) ---
EZVIZ_APP_KEY=your_app_key
EZVIZ_APP_SECRET=your_app_secret

# --- 中心风控引擎（事件上报目标）---
CENTER_MQTT_HOST=127.0.0.1
CENTER_MQTT_PORT=1883
# 事件主题，{device_id} 在运行时被设备 ID 替换
CENTER_MQTT_TOPIC=silvershield/home/{device_id}/events

# --- 可选：腾讯云 COS 证据存储 ---
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
